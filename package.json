{
  "name": "smart-ledger",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "inngest:dev": "npx --ignore-scripts=false inngest-cli@1.11.10 dev -u http://localhost:3001/api/inngest",
    "prisma:generate": "sh -c 'set -a; . ./.env.local; set +a; prisma generate \"$@\"' --",
    "prisma:migrate": "sh -c 'set -a; . ./.env.local; set +a; prisma migrate dev \"$@\"' --"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.30",
    "@clerk/nextjs": "^6.32.0",
    "@prisma/client": "^6.16.1",
    "ai": "^5.0.44",
    "date-fns": "^4.1.0",
    "inngest": "^3.54.2",
    "ioredis": "^5.7.0",
    "next": "15.5.3",
    "pdf-parse": "^1.1.1",
    "prisma": "^6.16.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/xlsx": "^0.0.36",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@clerk/shared",
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "prisma",
      "protobufjs",
      "sharp",
      "unrs-resolver"
    ]
  }
}
